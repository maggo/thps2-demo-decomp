# User-supplied or generated inputs
original/
out/

# The toolchain is downloaded or built locally; only the compiler verifier is ours.
toolchain/*
!toolchain/verify_egcs_1_1_1.py

# Archives and binary build products
.recovery/
*.7z
*.rar
*.zip
*.tar
*.tar.gz
*.tar.xz
*.a
*.bin
*.dll
*.elf
*.exe
*.lib
*.map
*.o
*.obj
*.sym

# Editors, assistants, worktrees, and local environment files
.claude/
.codex/
.agents/
.cursor/
.idea/
.vscode/
.worktrees/
.env
.env.*
!.env.example

# Python/test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Stray compiler output next to the sources
src/*.s
src/*.o
