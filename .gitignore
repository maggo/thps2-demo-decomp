# User-supplied or generated inputs
original/
out/

# The toolchain is user-supplied or built locally, except for what this
# repository authors: verify_egcs_1_1_1.py (checks the built compiler against its
# stock SHA-256 identities) and the egcs-1.1.1 build recipe (Dockerfile plus the
# unmodified decompals/old-gcc PSX patches and smoke tests it applies).
toolchain/*
!toolchain/verify_egcs_1_1_1.py
!toolchain/egcs-1.1.1/
toolchain/egcs-1.1.1/*
!toolchain/egcs-1.1.1/Dockerfile
!toolchain/egcs-1.1.1/patches/
toolchain/egcs-1.1.1/patches/*
!toolchain/egcs-1.1.1/patches/*.patch
!toolchain/egcs-1.1.1/tests/
toolchain/egcs-1.1.1/tests/*
!toolchain/egcs-1.1.1/tests/*.c

# Archives and binary build products
.recovery/
*.7z
*.rar
*.zip
*.tar
*.tar.gz
*.tar.xz
*.a
*.bin
*.dll
*.elf
*.exe
*.lib
*.map
*.o
*.obj
*.sym

# Editors, assistants, worktrees, and local environment files
.claude/
.codex/
.agents/
.cursor/
.idea/
.vscode/
.worktrees/
.env
.env.*
!.env.example

# Python/test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Stray compiler output next to the sources
src/*.s
src/*.o
